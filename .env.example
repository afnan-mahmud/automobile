# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dhaka-automobiles?retryWrites=true&w=majority

# Auth.js (NextAuth) secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of the deployed app (used by Auth.js for callbacks)
NEXTAUTH_URL=http://localhost:3000
